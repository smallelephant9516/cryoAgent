{
  "stage_info": {
    "name": "3d_reconstruction",
    "description": "Two-step 3D reconstruction workflow: Ab Initio Reconstruction → Homogeneous Refinement",
    "version": "1.0.0"
  },
  "required_inputs": [
    "picked_particles",
    "particle_coordinates"
  ],
  "outputs": [
    "final_structure",
    "resolution",
    "reconstruction_job_uid"
  ],
  "microscope_parameters": {
    "particle_diameter": 150.0,
    "symmetry": "C1",
    "pixel_size": 2.74,
    "voltage": 100.0,
    "cs_mm": 2.0,
    "dose": 33.2,
    "movies_path": "/home/daoyi/scratch/cryoEM_dataset/10316_ribo/data/*.mrcs",
    "gain_ref_path": null,
    "gain_rot": 0,
    "gain_flip": 0
  },
  "workflow": {
    "reconstruction_method": {
      "type": "ab_initio"
    },
    "ab_initio": {
      "num_classes": 1,
      "initial_resolution": 20.0,
      "final_resolution": 10.0,
      "max_iterations": 50,
      "symmetry": "C1",
      "particle_diameter": 180
    },
    "refinement": {
      "type": "homogeneous",
      "resolution": null,
      "symmetry": "C1",
      "particle_diameter": 180
    }
  },
  "react_workflow": {
    "steps": [
      {
        "name": "ab_initio_reconstruction",
        "description": "Generate initial 3D model using ab initio reconstruction without reference",
        "required_params": [
          "particles_job_uid",
          "num_classes"
        ],
        "optional_params": [
          "initial_resolution",
          "final_resolution",
          "max_iterations",
          "symmetry"
        ],
        "depends_on": [],
        "notes": "Uses 'homo_abinit' job type in CryoSPARC. Generates de novo 3D structures."
      },
      {
        "name": "homogeneous_refinement",
        "description": "Refine the single 3D structure to improve resolution and quality",
        "required_params": [
          "particles_job_uid",
          "volume_job_uid"
        ],
        "optional_params": [
          "refinement_resolution",
          "symmetry",
          "refine_do_init_scale_est",
          "refine_highpass_res",
          "refine_num_final_iterations",
          "refine_res_init",
          "refine_symmetry_do_align"
        ],
        "depends_on": [
          "ab_initio_reconstruction"
        ],
        "notes": "Uses 'homo_refine_new' job type in CryoSPARC. Requires volume from ab initio step."
      }
    ]
  }
}