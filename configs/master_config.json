{
  "master_workflow": {
    "name": "CryoEM Master Workflow",
    "description": "Complete 3-stage cryoEM processing pipeline",
    "stages": [
      {
        "name": "preprocessing",
        "description": "Pre-processing stage: Import movies, motion correction, CTF estimation, and micrograph selection",
        "enabled": true,
        "agent_group": "cryosparc",
        "agent_class": "PreprocessingAgent"
      },
      {
        "name": "particle_picking",
        "description": "Particle picking stage: Detect and extract particles from micrographs",
        "enabled": true,
        "agent_group": "cryosparc",
        "agent_class": "ParticlePickingAgent"
      },
      {
        "name": "reconstruction",
        "description": "3D reconstruction stage: Generate initial models and refine 3D structures",
        "enabled": true,
        "agent_group": "cryosparc",
        "agent_class": "ReconstructionAgent"
      }
    ],
    "execution_mode": "sequential",
    "stop_on_failure": true,
    "retry_failed_stages": false,
    "max_retries": 2
  },
  "cryosparc": {
    "host": "localhost",
    "base_port": 39000,
    "username": "lidaoyi16@hotmail.com",
    "password": "Password123",
    "license_id": "${LICENSE_ID}"
  },
  "relion": {
    "relion_exe": "/usr/local/bin/relion",
    "continue_job": true,
    "relion_dir": "/home/daoyi/relion/10025_rrc",
    "backend_execution": {
      "enabled": true,
      "default_timeout": 3600,
      "check_interval": 10,
      "max_concurrent_jobs": 3,
      "auto_cleanup": true,
      "conda_env": "relion-5.0"
    }
  },
  "agent": {
    "provider": "deepseek", 
    "temperature": 0.1,
    "max_iterations": 50,
    "verbose": true,
    "timeout": 60,
    "memory_control": {
      "clear_memory_on_new_conversation": true,
      "maintain_context_between_interactions": false
    },
    "react": {
      "max_reasoning_steps": 10,
      "enable_self_reflection": true,
      "require_explicit_reasoning": true
    },
    "models": {
      "deepseek": {
        "api_key": "${DEEPSEEK_API_KEY}",
        "base_url": "https://api.deepseek.com",
        "model_name": "deepseek-chat",
        "possible_models": ["deepseek-chat", "deepseek-reasoner"],
        "temperature": 0.1,
        "timeout": 60
      },
      "openai": {
        "api_key": "${OPENAI_API_KEY}",
        "base_url": "https://api.openai.com/v1",
        "model_name": "gpt-4o",
        "possible_models": ["gpt-4o", "gpt-4o-mini","gpt-5"],
        "temperature": 0.1,
        "timeout": 60
      },
      "panshi": {
        "api_key": "${PANSHI_API_KEY}",
        "base_url": "https://uni-api.cstcloud.cn/v1",
        "model_name": "deepseek-v3:671b",
        "possible_models": ["deepseek-v3:671b", "deepseek-r1:32b","qwen2.5-vl:72b","S1-Base-Lite"],
        "temperature": 0.1,
        "timeout": 180
      }
    }
  },
  "workflow": {
    "project_uid": "P1",
    "workspace_uid": "W1",
    "particle_diameter": 180.0
  },
  "job_management": {
    "default_timeout": 3600,
    "status_check_interval": 5,
    "max_retries": 3,
    "retry_delay": 60
  },
  "error_handling": {
    "max_consecutive_failures": 3,
    "fallback_strategies": [
      "retry_with_different_params",
      "skip_optional_steps",
      "manual_intervention_required"
    ]
  },
  "performance": {
    "parallel_jobs": false,
    "max_concurrent_jobs": 1,
    "resource_monitoring": true,
    "memory_limit": "8GB"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "cryoagent_master.log",
    "max_file_size": "10MB",
    "backup_count": 5
  }
}