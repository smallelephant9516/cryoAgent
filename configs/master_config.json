{
  "master_workflow": {
    "name": "CryoEM Master Workflow",
    "description": "Complete multi-stage cryoEM processing pipeline",
    "stages": [
      {
        "name": "preprocessing",
        "description": "Pre-processing stage: Import movies, motion correction, CTF estimation, and micrograph selection",
        "enabled": true,
        "agent_group": "cryosparc",
        "agent_class": "PreprocessingAgent"
      },
      {
        "name": "particle_picking",
        "description": "Particle picking stage: Detect and extract particles from micrographs",
        "enabled": true,
        "agent_group": "cryosparc",
        "agent_class": "ParticlePickingAgent"
      },
      {
        "name": "heterogeneity",
        "description": "Heterogeneity analysis stage: Determine true number of classes using ab initio + heterogeneous refinement and density comparison",
        "enabled": true,
        "agent_group": "cryosparc",
        "agent_class": "HeterogeneityAgent"
      },
      {
        "name": "optimization_2d",
        "description": "2D classification optimization stage: Iteratively refine particle selection using 2D classification and CryoSift",
        "enabled": false,
        "agent_group": "cryosparc",
        "agent_class": "Optimizer2DAgent"
      },
      {
        "name": "reconstruction",
        "description": "3D reconstruction stage: Generate initial models and refine 3D structures",
        "enabled": true,
        "agent_group": "cryosparc",
        "agent_class": "ReconstructionAgent"
      },
      {
        "name": "optimization",
        "description": "Box size optimization stage: Optimize box size/diameter for 3D reconstruction",
        "enabled": true,
        "agent_group": "cryosparc",
        "agent_class": "OptimizerAgent"
      },
      {
        "name": "polish",
        "description": "Polish refinement stage: Final refinement steps with CTF refinement and motion correction to achieve best possible resolution",
        "enabled": false,
        "agent_group": "cryosparc",
        "agent_class": "PolishAgent"
      }
    ],
    "execution_mode": "sequential",
    "stop_on_failure": true,
    "retry_failed_stages": false,
    "max_retries": 2
  },
  "cryosparc": {
    "host": "localhost",
    "base_port": 61000,
    "username": "lidaoyi16@hotmail.com",
    "password": "Password123",
    "license_id": "30717d7e-8f18-11f0-8d17-8b491a13a8e1"
  },
  "relion": {
    "relion_exe": "/usr/local/bin/relion",
    "continue_job": true,
    "relion_dir": "/home/daoyi/scratch/relion/10028/ccc",
    "backend_execution": {
      "enabled": true,
      "default_timeout": 84600,
      "check_interval": 10,
      "max_concurrent_jobs": 3,
      "auto_cleanup": true,
      "conda_env": "relion-5.0"
    }
  },
  "transition": {
    "micrograph_conversion": {
      "method": "helicon",
      "fallback_to_internal": true,
      "helicon": {
        "conda_env": "helicon",
        "command": "helicon",
        "force": 1,
        "extra_args": [],
        "timeout_seconds": 1800
      }
    },
    "particle_conversion": {
      "method": "helicon",
      "fallback_to_internal": true,
      "helicon": {
        "conda_env": "helicon",
        "command": "helicon",
        "force": 1,
        "extra_args": [],
        "timeout_seconds": 1800
      }
    }
  },
  "cryosift": {
    "cryosift_weights_path": "/home/daoyi/Github/cryoagent/Magellon/Sandbox/2dclass_evaluator/CNNTraining/final_model/final_model_cont.pth",
    "cryosift_weights_path_description": "Path to the CryoSift neural network weights file. This can be overridden by stage-specific configs.",
    "cryosift_evaluator_script_path": "/home/daoyi/Github/cryoagent/Magellon/Sandbox/2dclass_evaluator/CNNTraining/output_class_list.py",
    "cryosift_evaluator_script_path_description": "Path to the CryoSift evaluator script (output_class_list.py). This can be overridden by stage-specific configs.",
    "cryosift_env": "magellon2DAssess",
    "cryosift_env_description": "Conda environment used to run CryoSift evaluation. This can be overridden by stage-specific configs."
  },
  "agent": {
    "provider": "deepseek",
    "temperature": 0.1,
    "max_iterations": 50,
    "verbose": true,
    "timeout": 60,
    "memory_control": {
      "clear_memory_on_new_conversation": true,
      "maintain_context_between_interactions": false
    },
    "react": {
      "max_reasoning_steps": 10,
      "enable_self_reflection": true,
      "require_explicit_reasoning": true
    },
    "models": {
      "deepseek": {
        "api_key": "${DEEPSEEK_API_KEY}",
        "base_url": "https://api.deepseek.com",
        "model_name": "deepseek-chat",
        "possible_models": [
          "deepseek-chat",
          "deepseek-reasoner"
        ],
        "temperature": 0.1,
        "timeout": 60
      },
      "openai": {
        "api_key": "${OPENAI_API_KEY}",
        "base_url": "https://api.openai.com/v1",
        "model_name": "gpt-4o",
        "possible_models": [
          "gpt-4o",
          "gpt-4o-mini",
          "gpt-5"
        ],
        "temperature": 0.1,
        "timeout": 60
      },
      "panshi": {
        "api_key": "${PANSHI_API_KEY}",
        "base_url": "https://uni-api.cstcloud.cn/v1",
        "model_name": "deepseek-v3:671b",
        "possible_models": [
          "deepseek-v3:671b",
          "deepseek-r1:32b",
          "qwen2.5-vl:72b",
          "S1-Base-Lite"
        ],
        "temperature": 0.1,
        "timeout": 180
      }
    },
    "vision_models": {
      "panshi": {
        "api_key": "${PANSHI_API_KEY}",
        "base_url": "https://uni-api.cstcloud.cn/v1",
        "model_name": "qwen2.5-vl:72b",
        "possible_models": [
          "qwen2.5-vl:72b"
        ],
        "temperature": 0.1,
        "timeout": 60
      },
      "openai": {
        "api_key": "${OPENAI_API_KEY}",
        "base_url": "https://api.openai.com/v1",
        "model_name": "gpt-4o",
        "possible_models": [
          "gpt-4o",
          "gpt-4o-mini",
          "gpt-5"
        ],
        "temperature": 0.1,
        "timeout": 60
      }
    }
  },
  "workflow": {
    "project_uid": "P3",
    "workspace_uid": "W1"
  },
  "job_management": {
    "default_timeout": 84600,
    "status_check_interval": 10,
    "max_retries": 3,
    "retry_delay": 60
  },
  "error_handling": {
    "max_consecutive_failures": 3,
    "fallback_strategies": [
      "retry_with_different_params",
      "skip_optional_steps",
      "manual_intervention_required"
    ]
  },
  "performance": {
    "parallel_jobs": false,
    "max_concurrent_jobs": 1,
    "resource_monitoring": true,
    "memory_limit": "8GB"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "cryoagent_master.log",
    "max_file_size": "10MB",
    "backup_count": 5
  }
}
