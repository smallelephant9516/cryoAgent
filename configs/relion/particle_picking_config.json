{
  "workflow_name": "particle_picking_workflow",
  "description": "RELION particle picking workflow for cryoEM data processing",
  "version": "1.0.0",
  "stages": {
    "stage1": {
      "name": "particle_picking_and_classification",
      "description": "Blob picking, particle extraction, 2D classification, and auto-selection",
      "steps": [
        {
          "step_name": "blob_picker",
          "tool": "blob_picker",
          "description": "Perform blob picking using Laplacian-of-Gaussian filter",
          "parameters": {
            "particle_diameter": 200.0,
            "angpix": 1.0,
            "threshold": 0.25,
            "min_distance": -1,
            "LoG": true,
            "LoG_diam_min": 100.0,
            "LoG_diam_max": 300.0,
            "LoG_neighbour": 100.0,
            "LoG_adjust_threshold": 0.0,
            "LoG_upper_threshold": 99999.0,
            "LoG_use_ctf": false,
            "gauss_max": 0.1,
            "write_fom_maps": false,
            "only_do_unfinished": false,
            "wait_for_completion": true,
            "timeout": 3600,
            "check_interval": 30,
            "use_backend": false,
            "conda_env": "relion-5.0"
          },
          "input_requirements": {
            "input_star": "Path to micrographs STAR file from CTF estimation or micrograph selection"
          },
          "output_files": {
            "coordinate_files": "AutoPick/jobXXX/*_autopick.star files",
            "pipeline_control": "AutoPick/jobXXX/RELION_JOB_EXIT_SUCCESS"
          }
        },
        {
          "step_name": "particle_extraction",
          "tool": "particle_extraction",
          "description": "Extract particles from micrographs using coordinate files",
          "parameters": {
            "coord_suffix": "_autopick.star",
            "coord_dir": "ASINPUT",
            "extract_size": 256,
            "norm": true,
            "bg_radius": -1,
            "white_dust": -1,
            "black_dust": -1,
            "invert_contrast": false,
            "extract_bias_x": 0.0,
            "extract_bias_y": 0.0,
            "only_do_unfinished": false,
            "wait_for_completion": true,
            "timeout": 3600,
            "check_interval": 30,
            "use_backend": false,
            "conda_env": "relion-5.0"
          },
          "input_requirements": {
            "input_star": "Path to micrographs STAR file (same as blob_picker input)"
          },
          "output_files": {
            "particle_stack": "Particles/jobXXX/particles.mrcs",
            "particle_star": "Particles/jobXXX/particles.star",
            "pipeline_control": "Particles/jobXXX/RELION_JOB_EXIT_SUCCESS"
          }
        },
        {
          "step_name": "classification_2d",
          "tool": "classification_2d",
          "description": "Perform 2D classification of extracted particles",
          "parameters": {
            "K": 50,
            "iter": 25,
            "tau2_fudge": 2.0,
            "particle_diameter": 200.0,
            "angpix": 1.0,
            "offset_range": 6.0,
            "offset_step": 2.0,
            "oversampling": 1,
            "healpix_order": 2,
            "psi_step": -1,
            "skip_align": false,
            "skip_rotate": false,
            "ctf": true,
            "norm": true,
            "scale": true,
            "pool": 1,
            "j": 1,
            "only_do_unfinished": false,
            "wait_for_completion": true,
            "timeout": 7200,
            "check_interval": 60,
            "use_backend": false,
            "conda_env": "relion-5.0"
          },
          "input_requirements": {
            "input_star": "Path to particles STAR file from particle extraction"
          },
          "output_files": {
            "optimiser_star": "Class2D/jobXXX/run_optimiser.star",
            "class_averages": "Class2D/jobXXX/run_class001.mrc",
            "data_star": "Class2D/jobXXX/run_data.star",
            "pipeline_control": "Class2D/jobXXX/RELION_JOB_EXIT_SUCCESS"
          }
        },
        {
          "step_name": "auto_2d_selection",
          "tool": "auto_2d_selection",
          "description": "Automatically select good 2D classes and particles",
          "parameters": {
            "min_score": 0.5,
            "max_score": 999.0,
            "select_min_nr_particles": -1,
            "select_min_nr_classes": -1,
            "relative_thresholds": false,
            "auto_select": true,
            "fn_sel_parts": "particles.star",
            "fn_sel_classavgs": "class_averages.star",
            "wait_for_completion": true,
            "timeout": 1800,
            "check_interval": 30
          },
          "input_requirements": {
            "input_opt": "Path to optimiser.star file from 2D classification"
          },
          "output_files": {
            "selected_particles": "Select/jobXXX/particles.star",
            "selected_class_averages": "Select/jobXXX/class_averages.star",
            "pipeline_control": "Select/jobXXX/RELION_JOB_EXIT_SUCCESS"
          }
        }
      ]
    }
  },
  "workflow_parameters": {
    "default_particle_diameter": 200.0,
    "default_angpix": 1.0,
    "default_extract_size": 256,
    "default_num_classes": 50,
    "default_num_iterations": 25,
    "default_min_score": 0.5,
    "timeout_settings": {
      "blob_picker": 3600,
      "particle_extraction": 3600,
      "classification_2d": 7200,
      "auto_2d_selection": 1800
    },
    "backend_settings": {
      "enabled": false,
      "conda_env": "relion-5.0",
      "max_concurrent_jobs": 3,
      "default_timeout": 3600,
      "check_interval": 30
    }
  },
  "validation_rules": {
    "input_validation": {
      "micrographs_star": {
        "required": true,
        "description": "STAR file containing micrograph information",
        "file_types": [".star"]
      },
      "particles_star": {
        "required": true,
        "description": "STAR file containing particle information",
        "file_types": [".star"]
      }
    },
    "parameter_validation": {
      "particle_diameter": {
        "min": 50.0,
        "max": 1000.0,
        "description": "Particle diameter in Angstroms"
      },
      "angpix": {
        "min": 0.1,
        "max": 10.0,
        "description": "Pixel size in Angstroms"
      },
      "extract_size": {
        "min": 64,
        "max": 1024,
        "description": "Particle box size in pixels"
      },
      "K": {
        "min": 2,
        "max": 200,
        "description": "Number of 2D classes"
      },
      "iter": {
        "min": 5,
        "max": 100,
        "description": "Number of classification iterations"
      }
    }
  },
  "error_handling": {
    "retry_attempts": 3,
    "retry_delay": 60,
    "timeout_handling": "skip_and_continue",
    "critical_errors": [
      "file_not_found",
      "permission_denied",
      "insufficient_memory",
      "invalid_parameters"
    ],
    "warning_conditions": [
      "low_particle_count",
      "poor_classification_quality",
      "long_execution_time"
    ]
  },
  "output_analysis": {
    "quality_metrics": {
      "particle_count": "Number of extracted particles",
      "class_distribution": "Distribution of particles across classes",
      "average_score": "Average class score",
      "selected_fraction": "Fraction of particles selected"
    },
    "success_criteria": {
      "min_particles": 1000,
      "min_selected_fraction": 0.3,
      "max_class_imbalance": 0.8
    }
  }
}
