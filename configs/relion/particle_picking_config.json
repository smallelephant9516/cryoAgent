{
  "stage_info": {
    "name": "particle_picking",
    "description": "Particle picking stage: Blob picking, particle extraction, 2D classification, and auto-selection using RELION",
    "version": "1.0.0"
  },
  "required_inputs": [
    "micrographs_star",
    "pixel_size",
    "particle_diameter"
  ],
  "outputs": [
    "picked_particles",
    "particle_coordinates",
    "extracted_particles_star",
    "class_averages",
    "selected_particles_star"
  ],
  "workflow": {
    "blob_picker": {
      "pick_name": "autopick",
      "shrink": 0,
      "lowpass": 20,
      "min_distance": -1,
      "LoG": true,
      "LoG_diam_min": 180.0,
      "LoG_diam_max": 360.0
    },
    "template_picker": {
      "pickname": "autopick",
      "fn_topaz_exe": "relion_python_topaz",
      "ang": 5.0,
      "shrink": 0,
      "lowpass": 20.0,
      "threshold": 0.05,
      "min_distance": 100.0,
      "max_stddev_noise": 1.1,
      "invert": true,
      "ctf": true,
      "gpu": true
    },
    "particle_extraction": {
      "coord_suffix": "autopick.star",
      "extract_size": 440,
      "float16": true,
      "scale": 128,
      "norm": true,
      "bg_radius": 48,
      "white_dust": -1,
      "black_dust": -1,
      "invert_contrast": true,
      "extract_bias_x": 0.0,
      "extract_bias_y": 0.0
    },
    "classification_2d": {
      "K": 50,
      "iter": 25,
      "tau2_fudge": 2.0,
      "particle_diameter": 260.0, 
      "offset_range": 6.0,
      "offset_step": 2.0,
      "oversampling": 1,
      "healpix_order": 2,
      "psi_step": -1,
      "skip_align": false,
      "skip_rotate": false,
      "ctf": true,
      "norm": true,
      "scale": true,
      "pool": 1,
      "j": 1,
      "gpu":true
    },
    "auto_2d_selection": {
      "min_score": 0.4,
      "max_score": 999.0,
      "select_min_nr_particles": -1,
      "select_min_nr_classes": -1,
      "relative_thresholds": false,
      "auto_select": true,
      "fn_sel_parts": "particles.star",
      "fn_sel_classavgs": "class_averages.star"
    }
  },
  "react_workflow": {
    "steps": [
      {
        "name": "blob_picker",
        "description": "Perform blob picking using Laplacian-of-Gaussian filter",
        "required_params": [
          "input_star",
          "LoG_diam_min",
          "LoG_diam_max"
        ],
        "optional_params": [
          "angpix",
          "LoG_neighbour"
        ],
        "depends_on": [],
        "input_requirements": {
          "input_star": "Path to micrographs STAR file from CTF estimation or micrograph selection"
        },
        "output_files": {
          "coordinate_files": "AutoPick/jobXXX/*_autopick.star files",
          "pipeline_control": "AutoPick/jobXXX/RELION_JOB_EXIT_SUCCESS"
        }
      },
      {
        "name": "particle_extraction",
        "description": "Extract particles from micrographs using coordinate files",
        "required_params": [
          "input_star"
        ],
        "optional_params": [
          "coord_suffix",
          "extract_size",
          "float16",
          "scale",
          "norm",
          "bg_radius",
          "invert_contrast"
        ],
        "depends_on": [
          "blob_picker"
        ],
        "input_requirements": {
          "input_star": "Path to micrographs STAR file (same as blob_picker input)"
        },
        "output_files": {
          "particle_stack": "Particles/jobXXX/particles.mrcs",
          "particle_star": "Particles/jobXXX/particles.star",
          "pipeline_control": "Particles/jobXXX/RELION_JOB_EXIT_SUCCESS"
        }
      },
      {
        "name": "classification_2d",
        "description": "Perform 2D classification of extracted particles",
        "required_params": [
          "input_star"
        ],
        "optional_params": [
          "K",
          "iter",
          "tau2_fudge",
          "particle_diameter",
          "offset_range",
          "offset_step"
        ],
        "depends_on": [
          "particle_extraction"
        ],
        "input_requirements": {
          "input_star": "Path to particles STAR file from particle extraction"
        },
        "output_files": {
          "optimiser_star": "Class2D/jobXXX/run_optimiser.star",
          "class_averages": "Class2D/jobXXX/run_class_averages.mrc",
          "data_star": "Class2D/jobXXX/run_data.star",
          "pipeline_control": "Class2D/jobXXX/RELION_JOB_EXIT_SUCCESS"
        }
      },
      {
        "name": "auto_2d_selection",
        "description": "Automatically select good 2D classes and particles",
        "required_params": [
          "input_opt"
        ],
        "optional_params": [
          "min_score",
          "max_score",
          "select_min_nr_particles",
          "auto_select"
        ],
        "depends_on": [
          "classification_2d"
        ],
        "input_requirements": {
          "input_opt": "Path to optimiser.star file from 2D classification"
        },
        "output_files": {
          "selected_particles": "Select/jobXXX/particles.star",
          "selected_class_averages": "Select/jobXXX/class_averages.star",
          "pipeline_control": "Select/jobXXX/RELION_JOB_EXIT_SUCCESS"
        }
      },
      {
        "name": "template_picker",
        "description": "Perform template-based picking using reference images (e.g., from 2D class averages)",
        "required_params": [
          "input_star",
          "ref_star"
        ],
        "optional_params": [
          "pickname",
          "fn_topaz_exe",
          "ang",
          "shrink",
          "lowpass",
          "threshold",
          "min_distance",
          "max_stddev_noise",
          "invert",
          "ctf",
          "gpu"
        ],
        "depends_on": [
          "auto_2d_selection"
        ],
        "input_requirements": {
          "input_star": "Path to micrographs STAR file from CTF estimation or micrograph selection",
          "ref_star": "Path to reference STAR file (e.g., class averages from 2D classification)"
        },
        "output_files": {
          "coordinate_files": "AutoPick/jobXXX/*_autopick.star files",
          "pipeline_control": "AutoPick/jobXXX/RELION_JOB_EXIT_SUCCESS"
        }
      },
      {
        "name": "particle_extraction2",
        "description": "Extract particles from micrographs using coordinate files (second round)",
        "required_params": [
          "input_star"
        ],
        "optional_params": [
          "coord_suffix",
          "extract_size",
          "float16",
          "scale",
          "norm",
          "bg_radius",
          "invert_contrast"
        ],
        "depends_on": [
          "template_picker"
        ],
        "input_requirements": {
          "input_star": "Path to micrographs STAR file (same as template_picker input)"
        },
        "output_files": {
          "particle_stack": "Particles/jobXXX/particles.mrcs",
          "particle_star": "Particles/jobXXX/particles.star",
          "pipeline_control": "Particles/jobXXX/RELION_JOB_EXIT_SUCCESS"
        }
      },
      {
        "name": "classification_2d2",
        "description": "Perform 2D classification of extracted particles (second round)",
        "required_params": [
          "input_star"
        ],
        "optional_params": [
          "K",
          "iter",
          "tau2_fudge",
          "particle_diameter",
          "offset_range",
          "offset_step"
        ],
        "depends_on": [
          "particle_extraction2"
        ],
        "input_requirements": {
          "input_star": "Path to particles STAR file from particle extraction"
        },
        "output_files": {
          "optimiser_star": "Class2D/jobXXX/run_optimiser.star",
          "class_averages": "Class2D/jobXXX/run_class_averages.mrc",
          "data_star": "Class2D/jobXXX/run_data.star",
          "pipeline_control": "Class2D/jobXXX/RELION_JOB_EXIT_SUCCESS"
        }
      },
      {
        "name": "auto_2d_selection2",
        "description": "Automatically select good 2D classes and particles (second round)",
        "required_params": [
          "input_opt"
        ],
        "optional_params": [
          "min_score",
          "max_score",
          "select_min_nr_particles",
          "auto_select"
        ],
        "depends_on": [
          "classification_2d2"
        ],
        "input_requirements": {
          "input_opt": "Path to optimiser.star file from 2D classification"
        },
        "output_files": {
          "selected_particles": "Select/jobXXX/particles.star",
          "selected_class_averages": "Select/jobXXX/class_averages.star",
          "pipeline_control": "Select/jobXXX/RELION_JOB_EXIT_SUCCESS"
        }
      }
    ]
  }
}
