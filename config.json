    },
    "motion_correction": {
      "binning": 1,
      "patch_size": 5,
      "max_shift": 15.0,
      "min_patch_shift_ratio": 0.8
    },
    "ctf_estimation": {
      "min_res": 30.0,
      "max_res": 4.0,
      "defocus_range": [0.5, 4.0],
      "astigmatism_tolerance": 100.0
    }
  },
  "job_management": {
    "default_timeout": 3600,
    "status_check_interval": 10,
    "max_retries": 3,
    "retry_delay": 60
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "cryoagent.log",
    "max_file_size": "10MB",
    "backup_count": 5
  },
  "react_workflow": {
    "steps": [
      {
        "name": "import_movies",
        "description": "Import movie files into CryoSPARC",
        "required_params": ["movies_path", "pixel_size", "voltage", "cs_mm", "dose"],
        "optional_params": ["gain_ref_path"],
        "depends_on": []
      },
      {
        "name": "motion_correction",
        "description": "Perform motion correction on imported movies",
        "required_params": ["movies_job_uid"],
        "optional_params": ["binning", "patch_size", "max_shift"],
        "depends_on": ["import_movies"]
      },
      {
        "name": "ctf_estimation",
        "description": "Estimate CTF parameters for micrographs",
        "required_params": ["micrographs_job_uid"],
        "optional_params": ["min_res", "max_res", "defocus_range"],
        "depends_on": ["motion_correction"]
      }
    ]
  },
  "error_handling": {
    "max_consecutive_failures": 3,
    "fallback_strategies": [
      "retry_with_different_params",
      "skip_optional_steps",
      "manual_intervention_required"
    ]
  },
  "performance": {
    "parallel_jobs": false,
    "max_concurrent_jobs": 1,
    "resource_monitoring": true,
    "memory_limit": "8GB"
  }
